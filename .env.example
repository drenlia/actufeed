# Environment variables for News Feed Application
# Copy this file to .env and update the values as needed

# Host configuration
# Set this to your domain name (e.g., news.example.com) or use 127.0.0.1 for local IPv4 dev
# This tells Vite which host(s) to allow
HOST=127.0.0.1

# Alternative: Use ALLOWED_HOSTS for multiple hosts (comma-separated)
# If set, this takes precedence over HOST
# ALLOWED_HOSTS=news.example.com,www.example.com

# CORS Configuration
# Comma-separated list of allowed origins (e.g., https://news.example.com,https://www.example.com)
# If not set, uses HOST environment variable
# ALLOWED_ORIGINS=https://news.example.com,https://www.example.com

# Optional: comma-separated secrets; if set, RSS/HTML/YouTube proxy routes require header
# X-Actufeed-Client-Key matching one value, OR a trusted browser Origin (see server.js).
# In local dev with Vite (npm run dev:all), leave this unset unless you also send the key from the web app —
# otherwise YouTube channel search can get 403 "Proxy access denied" (Vite proxy may omit Origin/Referer).
# Mobile: EXPO_PUBLIC_ACTUFEED_PROXY_CLIENT_KEY. Not proof against reverse-engineering — see actufeed-app README.
# ACTUFEED_PROXY_CLIENT_KEYS=

# YouTube Data API v3 key: channel search, resolve metadata, and (when set) article fetch via playlistItems.list
# instead of flaky youtube.com/feeds/videos.xml. Same key — keep on server only, not in the app.
# Docker: .env is NOT baked into the image; docker-compose.yml must pass this into the container (see YOUTUBE_DATA_API_KEY there).
# After changing .env: docker compose up -d --build (or recreate the service) so the new env is applied.
# YOUTUBE_DATA_API_KEY=

# HTTPS Configuration (for HSTS header)
# Set to true if using HTTPS in production
# HTTPS=false

# Port configuration (optional, defaults shown)
# Copy this file to .env for local dev (Mac/Linux without Docker). Vite and server.js both read these.
# PORT=3072
# VITE_PORT=3072
# BACKEND_PORT=3073
# Optional: full URL Vite uses when proxying /api in dev (default http://127.0.0.1:BACKEND_PORT).
# BACKEND_PROXY_TARGET=http://127.0.0.1:3073
#
# Client (Vite): optional overrides when dev API calls must bypass the proxy.
# With the UI at http://YOUR_LAN_IP:3072, the app already uses http://YOUR_LAN_IP:3073/api by default.
# VITE_BACKEND_PORT=3073
# VITE_API_BASE=http://127.0.0.1:3073
#
# Local dev without Docker:
#   1. cp .env.example .env
#   2. Adjust VITE_PORT / BACKEND_PORT if 3072/3073 are busy
#   3. npm run dev:all   (Vite + API), or two terminals: npm run dev && npm run server:dev
# Do not set NODE_ENV=development in .env unless you want every `node server.js` to be dev mode.

# Docker logging (syslog driver in docker-compose.yml and docker-compose.dev.yml)
# Optional. If unset, compose uses udp://127.0.0.1:514 (host loopback, same role as localhost) — only sends
# anywhere if rsyslog/syslog-ng (or similar) on the Docker host listens on UDP 514. For production, set
# your remote collector, e.g.:
# SYSLOG_ADDRESS=udp://logs.example.com:514
