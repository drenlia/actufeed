{
  "name": "actufeed",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n vite,api -c blue,green \"npm run dev\" \"npm run server:dev\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "node server.js",
    "server:dev": "NODE_ENV=development node server.js",
    "start": "node server.js",
    "dev:docker": "concurrently -n vite,proxy -c blue,green \"npm run dev\" \"env NODE_ENV=development node server.js\""
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "iconv-lite": "^0.7.2",
    "jsdom": "^24.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4"
  }
}
